{
  "manifest_version": 3,
  "name": "Course Passable?",
  "version": "1.1.3",
  "description": "Enhanced grade viewing and what-if calculator for Brightspace",
  "permissions": ["activeTab", "storage", "declarativeContent"],
  "host_permissions": ["https://purdue.brightspace.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "images/icon16.png"
  },
  "content_scripts": [
    {
      "matches": ["https://purdue.brightspace.com/d2l/lms/grades/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
  
}